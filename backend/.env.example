# Pooled connection URL dari Neon (hostname mengandung "-pooler") untuk runtime Vercel Functions
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require&connect_timeout=10"

# Direct (unpooled) connection URL dari Neon (tanpa "-pooler") untuk `npx prisma migrate deploy`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# Wajib diganti di production dengan string acak yang kuat (minimal 32 karakter)
JWT_SECRET="ganti_dengan_secret_acak_panjang_di_production"

# Domain frontend Next.js di Vercel (pisahkan dengan koma jika lebih dari satu)
CORS_ORIGIN="https://nama-frontend-anda.vercel.app"

PORT=3001

# Firebase Cloud Messaging (FCM) — Ambil dari Firebase Console > Project Settings > Service Accounts
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""
# Alternatif: tempel seluruh isi file Service Account JSON dalam 1 baris
# FIREBASE_SERVICE_ACCOUNT_JSON=""
